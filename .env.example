# Copie este archivo a .env y ajuste los valores. Nunca suba .env al repositorio.
# En Docker la imagen ya fija NODE_ENV=production y UPLOADS_DIR=/app/uploads: no los
# sobrescriba en el env-file. Monte un volumen en /app/uploads y otro para E_INVOICING_CERTS_DIR.
NODE_ENV=development
PORT=3000
# Dominios públicos de apreu-web (coma separada). Si apreu-web reenvía /api con su nginx no hace falta.
CORS_ORIGINS=http://localhost:4200
# Proxies inversos delante de la API (Express "trust proxy"): número de saltos o IP/subredes.
# 1 = detrás del nginx de apreu-web (Docker). Vacío = API expuesta directamente (no confiar en X-Forwarded-For).
TRUST_PROXY=

JWT_SECRET=cambie-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Servidor PostgreSQL 16 con una BD por colegio (ADR-0008). Por defecto el puerto es 5432;
# el contenedor de desarrollo apreu-dev-pg publica el 54331.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=54331
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres
TENANT_DB_PREFIX=apreu_
# Minutos sin uso tras los cuales se cierra el pool de conexiones de un colegio (0 = nunca)
TENANT_POOL_IDLE_MINUTES=30

# BD maestra con la tabla tenants (por defecto usa las credenciales anteriores; trabaja en UTC)
MASTER_DB_NAME=apreu_master
# MASTER_DB_HOST=
# MASTER_DB_PORT=
# MASTER_DB_USER=
# MASTER_DB_PASSWORD=

# Colegio usado cuando la petición no trae X-Tenant (solo desarrollo)
DEFAULT_TENANT=
TENANT_CACHE_TTL_SECONDS=60
# Cada cuántos segundos se vuelve a leer solo el estado (status) del colegio cacheado, para que
# una suspensión desde superadmin aplique en segundos en todas las instancias (0 = en cada petición)
TENANT_STATUS_TTL_SECONDS=5

# Secreto compartido con superadmin-api para /api/internal/** (cabecera X-Internal-Token).
# Vacío = API interna deshabilitada. En producción, mínimo 32 caracteres (p. ej. openssl rand -hex 32).
INTERNAL_API_TOKEN=

# Archivos subidos (fotos, logos, adjuntos). Una subcarpeta por colegio. No debe servirse por web.
UPLOADS_DIR=./uploads
# Secreto del QR del carnet (si se omite se deriva de JWT_SECRET)
STUDENT_QR_SECRET=
# URL codificada en el QR de los certificados PDF (página pública /verificar/:code de apreu-web).
# Marcadores: {tenant} (slug), {kind} (estudiantil = certificado de estudios, laboral = certificado laboral), {code}.
# Vacío = el QR contiene solo el código de verificación. Valor recomendado:
DOCUMENT_VERIFY_URL_TEMPLATE=https://{tenant}.apreu.co/verificar/{code}?tipo={kind}
# Facturación electrónica: carpeta absoluta con <slug>.pem (+ <slug>.passphrase) y clave AES-256 en base64
E_INVOICING_CERTS_DIR=
E_INVOICING_SECRET_KEY=
